{
  "manifest_version": 3,
  "name": "News Crawl",
  "version": "1.0.1",
  "description": "Crawl Data",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "News Crawl"
  },
  "minimum_chrome_version": "116"
}
